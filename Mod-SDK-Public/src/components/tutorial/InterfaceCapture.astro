---
import { Image } from 'astro:assets';
import type { InterfaceCaptureProps } from './InterfaceCaptureProps';

type Props = InterfaceCaptureProps;
const { image, alt, caption, version = '0.11.8' } = Astro.props;
---

<figure class="interface-capture">
  <Image src={image} alt={alt} width={image.width} height={image.height} loading="lazy" decoding="async" format="webp" quality={92} />
  <figcaption>
    <span class="capture-caption">{caption}</span>
    <span class="capture-source">Toolkit v{version}.</span>
  </figcaption>
</figure>

<style>
  .interface-capture {
    margin: 1.5rem 0;
    overflow: hidden;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.5rem;
    background: var(--sl-color-bg-sidebar);
  }
  img {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 0;
  }
  figcaption {
    margin: 0;
    padding: 0.75rem 1rem;
    border-top: 1px solid var(--sl-color-hairline-light);
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .capture-caption,
  .capture-source {
    display: block;
    margin: 0;
  }
  .capture-source {
    margin-top: 0.35rem;
    color: var(--sl-color-gray-2);
    font-size: 0.8125rem;
  }
</style>
